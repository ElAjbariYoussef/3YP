{
  "version": 1,
  "author": "Anonymous maker",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": -120, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 6, "left": 250, "attrs": { "color": "yellow" } },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 90,
      "left": 240,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:34", "green", [ "v0" ] ],
    [ "esp:2", "r1:1", "orange", [ "h0" ] ],
    [ "r1:2", "led1:A", "orange", [ "h0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}